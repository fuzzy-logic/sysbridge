# Copy to ~/.config/systemd/user/sysbridge-http.service.d/local.conf (or run
# `systemctl --user edit sysbridge-http` and paste), then `systemctl --user daemon-reload`.
# Only the values that differ from the unit's defaults belong here.
[Service]
Environment=SYSBRIDGE_DIR=%h/ai/sysbridge
# Environment=SYSBRIDGE_PYTHON=/usr/bin/python3
# Environment=SYSBRIDGE_PORT=8182     # if you skipped the port-80 sysctl
# Environment=SYSBRIDGE_LLAMA_SERVERS=router=http://127.0.0.1:8080,reviewer=http://127.0.0.1:8127
