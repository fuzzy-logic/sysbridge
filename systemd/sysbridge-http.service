[Unit]
Description=sysbridge — http://localhost/ launcher for .html apps, system probes, allowlisted actions
Documentation=https://github.com/fuzzy-logic/sysbridge
# The bridge is useful without the router; this only orders startup when both exist.
After=default.target

[Service]
Type=simple
# Override these in a drop-in (systemctl --user edit sysbridge-http), never here, so a
# git pull does not clobber your paths. See sysbridge-http.service.d/local.conf.example.
Environment=SYSBRIDGE_PYTHON=/usr/bin/python3
Environment=SYSBRIDGE_DIR=%h/.local/share/sysbridge
# 80 so the launcher is plain http://localhost/ . A user service may only bind
# ports below 1024 after the one-time kernel setting in README → Install
# (net.ipv4.ip_unprivileged_port_start = 80). Set 8182 here to skip that.
Environment=SYSBRIDGE_PORT=80
# The llama-servers the bridge watches for the dashboard (llama, llama_slots and
# router_models probes): name=url, comma separated. A server that is down just
# shows as down; the "router" entry is the one whose presets get file sizes.
Environment=SYSBRIDGE_LLAMA_SERVERS=router=http://127.0.0.1:8080
# 1 (default): the bridge writes the ordinary token into each served page's
# localStorage so apps just work. 0: users paste it in the launcher's Settings.
Environment=SYSBRIDGE_TOKEN_INJECT=1
ExecStart=/bin/sh -c 'cd "$SYSBRIDGE_DIR" && exec "$SYSBRIDGE_PYTHON" -m bridge --port "$SYSBRIDGE_PORT"'
Restart=always
RestartSec=3
Nice=5
MemoryMax=512M

# Hardening, copied from pi-cli-safe with two deliberate omissions:
#   * no ProtectProc=/ProcSubset= — the kfd_holders probe reads other processes' /proc/*/fd
#   * no PrivateDevices=          — rocm-smi and the /dev/kfd check need the real /dev
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# %t is the per-user runtime dir (/run/user/UID) where the 0600 action token lives.
ReadWritePaths=%t
# Uploaded apps live in $STATE_DIRECTORY/apps (~/.local/state/sysbridge/apps).
# StateDirectory, not ReadWritePaths: systemd creates it, so a fresh install
# does not fail with 226/NAMESPACE, and it stays writable under ProtectHome.
StateDirectory=sysbridge
# xrt-smi may want a cache dir under the (read-only) home; point XDG_CACHE_HOME here.
CacheDirectory=sysbridge
Environment=XDG_CACHE_HOME=%C
NoNewPrivileges=true

[Install]
WantedBy=default.target
